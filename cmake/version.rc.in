#include <windows.h>

1 VERSIONINFO
FILEVERSION @UIMGUI_VERSION_MAJOR@,@UIMGUI_VERSION_MINOR@,@UIMGUI_VERSION_PATCH@,0
PRODUCTVERSION @UIMGUI_VERSION_MAJOR@,@UIMGUI_VERSION_MINOR@,@UIMGUI_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0x0L
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "psydack\0"
            VALUE "FileDescription", "@UIMGUI_TARGET_NAME@ native library for UImGui\0"
            VALUE "FileVersion", "@UIMGUI_VERSION_STRING@\0"
            VALUE "InternalName", "@UIMGUI_TARGET_NAME@\0"
            VALUE "OriginalFilename", "@UIMGUI_TARGET_NAME@.dll\0"
            VALUE "ProductName", "UImGui native dependencies\0"
            VALUE "ProductVersion", "@UIMGUI_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
